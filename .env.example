# Copie este archivo como .env. Nunca publique su .env real.
SECRET_KEY=reemplace-por-una-clave-larga-y-aleatoria

# OPCIÓN A - PostgreSQL local (reemplace usuario y contraseña):
DATABASE_URL=postgresql://postgres:SU_CONTRASENA@localhost:5432/emitech_store

# OPCIÓN B - Para ejecutar localmente con la base creada en Render, sustituya
# la línea anterior por la External Database URL copiada desde Render.
# En el servicio web de Render no se sube este archivo: DATABASE_URL se enlaza
# automáticamente con Render Postgres y SECRET_KEY se genera mediante render.yaml.
