# Copie este archivo como .env y complete únicamente los datos de su MySQL local.
# El archivo .env está ignorado por Git y nunca debe subirse al repositorio.
SECRET_KEY=cambie-esta-clave-en-su-computadora
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=SU_CONTRASENA_DE_MYSQL
MYSQL_DATABASE=emitech_store
