# Copie este archivo como .env. Nunca publique su .env real.
SECRET_KEY=reemplace-por-una-clave-larga-y-aleatoria

# PostgreSQL local (reemplace usuario y contraseña):
DATABASE_URL=postgresql://postgres:SU_CONTRASENA@localhost:5432/emitech_store

# En Render no se sube este archivo: DATABASE_URL se enlaza con Render Postgres
# y SECRET_KEY se genera desde el panel o mediante render.yaml.
